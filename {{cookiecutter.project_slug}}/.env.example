# {{cookiecutter.project_name}} Environment Variables
# Copy this file to .env and update the values for your environment

# Database Configuration
DB_LOCAL_NAME={{cookiecutter.project_slug}}_dev
DB_LOCAL_USER={{cookiecutter.project_slug}}_user
DB_LOCAL_PASS=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Production Database (if different)
DB_NAME={{cookiecutter.project_slug}}_prod
DB_USER={{cookiecutter.project_slug}}_prod_user
DB_PASS=your_production_password_here
HOST=your_production_host
PORT=5432

# Django Secret Key (generate a new one for production)
SECRET_KEY=your-secret-key-here

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated, update for production)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Origins (comma-separated, update for your frontend)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Media and Static Files
MEDIA_ROOT=/path/to/media
MEDIA_URL=/media/
STATIC_ROOT=/path/to/static
STATIC_URL=/static/

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_password

# Optional: Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn_here

# Optional: Redis for caching/sessions
# REDIS_URL=redis://localhost:6379/0